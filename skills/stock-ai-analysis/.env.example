# ==============================================================================
# Stock AI Quant Pipeline - Environment Configuration Example
# ==============================================================================
# このファイルをコピーして `.env` を作成し、必要に応じて設定値を入力してください:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. AI & NLP API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Antigravity SDK / 自律ディープリサーチ用)
# Google AI Studio (https://aistudio.google.com/) から取得したキーを設定してください
GEMINI_API_KEY="your_gemini_api_key_here"

# Hugging Face Access Token (金融BERTモデルのダウンロード高速化・レート制限回避用)
# Hugging Face Settings (https://huggingface.co/settings/tokens) から取得可能です (任意)
HF_TOKEN="your_huggingface_token_here"

# ------------------------------------------------------------------------------
# 2. Path & Runtime Settings (外部プロジェクト連携・カスタムデータパス用)
# ------------------------------------------------------------------------------
# 外部プロジェクトから本リポジトリのスクリプトを呼び出す際、
# 明示的にリポジトリのルートパスを指定したい場合に設定します (任意)
# STOCK_AI_DIR="/path/to/stock-ai-quant"

# カタリストやマッピングファイル (wikipedia_mapping.json 等) のデータ格納ディレクトリを
# カスタムパスに指定したい場合に設定します (未設定の場合は $REPO_DIR/data が自動使用されます) (任意)
# STOCK_AI_DATA_DIR="./data"
